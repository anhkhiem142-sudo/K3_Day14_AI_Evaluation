# Used only by domain_assistant.py when generating real RAG answers.
# OpenRouter is the default lab option; openrouter/free needs no paid credits.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Optional OpenAI fallback. It is used only when OPENROUTER_API_KEY is absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
